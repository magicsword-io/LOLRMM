{
  "name": "lolrmm-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare:data": "cd .. && python3 bin/site.py",
    "dev": "npm run prepare:data && astro dev",
    "check": "astro check",
    "build": "npm run prepare:data && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "test": "playwright test",
    "format": "prettier --write src scripts tests *.mjs *.ts *.json"
  },
  "dependencies": {
    "astro": "7.3.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "prettier": "3.9.7",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3"
  }
}

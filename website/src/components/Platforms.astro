---
interface Props {
  names: string[];
  compact?: boolean;
}
const { names, compact = false } = Astro.props;
const icons: Record<string, string> = {
  Windows: 'windows',
  Linux: 'linux',
  macOS: 'macos',
  Android: 'android',
  iOS: 'ios',
  ChromeOS: 'chromeos',
};
---

<span class:list={['platforms', { 'platforms-compact': compact }]}>
  {names.length ? (
    names.map((name) => (
      <span class="platform" title={name} data-platform={name}>
        {icons[name] && (
          <img
            src={`/platforms/${icons[name]}.svg`}
            width="18"
            height="18"
            alt=""
          />
        )}
        <span class:list={{ 'sr-only': compact && Boolean(icons[name]) }}>
          {name}
        </span>
      </span>
    ))
  ) : (
    <span>Not recorded</span>
  )}
</span>

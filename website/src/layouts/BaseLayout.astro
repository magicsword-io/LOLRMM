---
import '../styles/global.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { repository } from '../lib/catalog';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'LOLRMM — Living Off the Land Remote Monitoring and Management',
  description = 'Explore remote monitoring and management tools, forensic artifacts, and detections. Open source intelligence for threat hunters and defenders.',
} = Astro.props;
const nav = [
  ['Catalog', '/'],
  ['Detections', '/detections/'],
  ['API', '/api/'],
  ['About', '/about/'],
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c100e" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="describedby" href="/llms.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LOLRMM" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta
      property="og:image"
      content={new URL('/images/logo.png', Astro.site)}
    />
    <meta property="og:image:alt" content="LOLRMM logo" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('lolrmm-theme');
        if (theme === 'light' || theme === 'dark')
          document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <GoogleAnalytics />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "LOLRMM",
        "url": "https://lolrmm.io",
        "logo": "https://lolrmm.io/images/logo.png",
        "description": "Living Off The Land Remote Monitoring and Management — A community-maintained catalog of remote monitoring and management tools with forensic artifacts, network indicators, and detections for threat hunters and defenders.",
        "sameAs": ["https://github.com/magicsword-io/LOLRMM"]
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "LOLRMM",
        "url": "https://lolrmm.io",
        "description": "Explore remote monitoring and management tools, forensic artifacts, and detections. Open source intelligence for threat hunters and defenders."
      }
    ])} />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="wrap navigation">
        <a class="brand" href="/" aria-label="LOLRMM home">
          <img src="/images/logo.svg" width="56" height="56" alt="" />
          <span>
            LOLRMM<small>THE REMOTE ACCESS CATALOG</small>
          </span>
        </a>
        <nav aria-label="Main navigation">
          {nav.map(([label, href]) => (
            <a
              href={href}
              aria-current={
                (
                  href === '/'
                    ? Astro.url.pathname === '/' ||
                      Astro.url.pathname.startsWith('/tools/')
                    : Astro.url.pathname.startsWith(href)
                )
                  ? 'page'
                  : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
        <div class="nav-actions">
          <a class="github-link" href={repository}>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              width="16"
              height="16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            GitHub
          </a>
          <button
            class="icon-button"
            id="theme-toggle"
            aria-label="Switch to light theme"
            title="Switch color theme"
            hidden
          >
            ◐
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <div class="footer-brand">
        <img src="/images/logo.svg" alt="" width="34" height="34" />
        <span>
          Community intelligence for defenders.
          <small>
            A <a href="https://www.magicsword.io/">MagicSword</a> project.
          </small>
        </span>
      </div>
      <div>
        <a href="/llms.txt">LLM guide</a>
        <a href={repository + '/issues/new/choose'}>Submit a tool ↗</a>
        <a href="https://loldrivers.io/">LOLDrivers ↗</a>
        <a href="https://lolskills.io/">LOLSkills ↗</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      function updateLabel() {
        toggle?.setAttribute(
          'aria-label',
          `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`,
        );
      }
      if (toggle) {
        toggle.hidden = false;
        updateLabel();
        toggle.addEventListener('click', () => {
          const theme =
            document.documentElement.dataset.theme === 'dark'
              ? 'light'
              : 'dark';
          document.documentElement.dataset.theme = theme;
          try {
            localStorage.setItem('lolrmm-theme', theme);
          } catch {}
          updateLabel();
        });
      }
    </script>
  </body>
</html>
